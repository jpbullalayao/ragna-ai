# AI Gateway (Vercel OIDC after `vercel link` + `vercel env pull`, or set AI_GATEWAY_API_KEY)
# AI_GATEWAY_API_KEY=

# Vercel Flags (OIDC after `vercel env pull`, or set FLAGS SDK key)
# Toggle free-oss-model in the dashboard:
# https://vercel.com/jpbullalayaos-projects/ragna-research/flag/free-oss-model
# FLAGS=

# Optional: default Notion parent page UUID for publish flows.
# See README "Notion connection". Share the page with the Connect Notion integration.
# NOTION_PARENT_PAGE_ID=
